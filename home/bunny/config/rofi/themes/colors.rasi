* {
    background0:     #151515;
    background1:     #1c1c1c;
    background2:     #242424;

    foreground0:     #c8c8c8;
    foreground1:     #e0e0e0;
    foreground-dim:  #8a8a8a;

    primary:         #6e6e6e;
    primary-hover:   #8a8a8a;
    muted:           #505050;
    border-col:      #2e2e2e;

    success:         #8e8e8e;
    warning:         #a4a4a4;
    error:           #c4c4c4;

    shade0:          #1a1a1a;
    shade1:          #252525;
    shade2:          #303030;
    shade3:          #4a4a4a;
    shade4:          #6e6e6e;
    shade5:          #8a8a8a;
    shade6:          #a6a6a6;
    shade7:          #c4c4c4;

    /* Translucent variants - hyprland blurs behind these (see hypr/window_rules.lua) */
    background0-alpha: #151515e6;
    background1-alpha: #1c1c1cbf;

    background:      @background0;
    selected:        @primary;
    selected-bg:     @background2;
    selected-border: @shade3;
}
