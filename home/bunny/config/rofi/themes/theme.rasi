/* ─────────────────────────────────────────────────────────
   Rofi theme — grayscale, matches the quickshell aesthetic
   ───────────────────────────────────────────────────────── */

* {
    font: "Iosevka 14";
}

@import "./colors.rasi"

/* ── Window ────────────────────────────────────────────── */
window {
    width:            640px;
    location:         center;
    anchor:           center;
    y-offset:         -60px;

    border:           1px solid;
    border-color:     @shade2;
    border-radius:    16px;

    padding:          0px;
    background-color: @background0-alpha;
}

/* No mode-switcher: modes are keyboard-only (Ctrl+Tab) */
mainbox {
    padding:          0px;
    spacing:          0px;
    background-color: transparent;
    children:         [ inputbar, message, listview ];
}

/* ── Search bar ────────────────────────────────────────── */
inputbar {
    padding:          18px 20px;
    spacing:          12px;
    children:         [ prompt, entry ];
    background-color: @background1-alpha;
    border:           0px 0px 1px 0px;
    border-color:     @shade1;
}

prompt {
    font:             "JetBrainsMono Nerd Font 14";
    text-color:       @foreground-dim;
    background-color: transparent;
    vertical-align:   0.5;
}

entry {
    text-color:        @foreground1;
    padding:           0px;
    placeholder:       "Search apps…";
    placeholder-color: @muted;
    background-color:  transparent;
    vertical-align:    0.5;
    cursor:            text;
}

textbox-prompt-colon {
    str:    "";
    expand: false;
}

/* ── Optional message row ──────────────────────────────── */
message {
    padding:          10px 20px;
    background-color: @background1-alpha;
}

textbox {
    text-color:       @foreground-dim;
    background-color: transparent;
}

error-message {
    padding:          12px;
    background-color: @background1-alpha;
    border:           1px solid;
    border-color:     @error;
}

/* ── List of results ───────────────────────────────────── */
listview {
    lines:            8;
    columns:          1;
    fixed-height:     false;
    dynamic:          true;
    scrollbar:        false;
    cycle:            true;
    padding:          8px;
    spacing:          2px;
    background-color: transparent;
    border:           0px;
}

/* Two-line rows: name, then description underneath */
element {
    padding:          8px 14px;
    border-radius:    10px;
    spacing:          14px;
    text-color:       @foreground0;
    background-color: transparent;
    cursor:           pointer;
}

element-icon {
    size:             30px;
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
    cursor:           inherit;
    /* highlight: only takes a literal colour, not a @palette link */
    highlight:        bold underline #e0e0e0;
}

element normal active {
    text-color:       @primary-hover;
}

element normal urgent {
    text-color:       @error;
}

element alternate normal {
    background-color: transparent;
}

element alternate active {
    text-color:       @primary-hover;
    background-color: transparent;
}

element alternate urgent {
    text-color:       @error;
    background-color: transparent;
}

/* Selection — a soft filled row, no border (avoids text jitter) */
element selected normal {
    text-color:       @foreground1;
    background-color: @selected-bg;
}

element selected active {
    text-color:       @foreground1;
    background-color: @selected-bg;
}

element selected urgent {
    text-color:       @error;
    background-color: @selected-bg;
}
