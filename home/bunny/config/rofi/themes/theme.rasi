/* ─────────────────────────────────────────────────────────
   Rofi theme — grayscale, matches the quickshell aesthetic
   ───────────────────────────────────────────────────────── */

* {
    font: "Iosevka 14";
}

@import "./colors.rasi"

/* ── Window ────────────────────────────────────────────── */
window {
    width:            620px;
    location:         center;
    anchor:           center;
    y-offset:         -80px;

    border:           1px solid;
    border-color:     @shade2;
    border-radius:    14px;

    padding:          0px;
    background-color: @background0;
}

mainbox {
    padding:          14px 16px 16px 16px;
    spacing:          10px;
    background-color: @background0;
    children:         [ inputbar, message, listview, mode-switcher ];
}

/* ── Input bar ─────────────────────────────────────────── */
inputbar {
    padding:          10px 12px;
    border-radius:    10px;
    spacing:          10px;
    children:         [ prompt, entry ];
    background-color: @background1;
    border:           1px solid;
    border-color:     @shade1;
}

prompt {
    padding:          0 4px 0 2px;
    enabled:          true;
    text-color:       @foreground-dim;
    background-color: transparent;
    vertical-align:   0.5;
}

entry {
    text-color:        @foreground1;
    padding:           0px;
    placeholder:       "Type to search…";
    placeholder-color: @muted;
    background-color:  transparent;
    vertical-align:    0.5;
    cursor:            text;
}

textbox-prompt-colon {
    str:    "";
    expand: false;
}

/* ── Optional message row ──────────────────────────────── */
message {
    padding:          8px 12px;
    border-radius:    8px;
    background-color: @background1;
    border:           1px solid;
    border-color:     @shade1;
}

textbox {
    text-color: @foreground-dim;
}

/* ── List of results ───────────────────────────────────── */
listview {
    lines:            8;
    columns:          1;
    fixed-height:     true;
    dynamic:          true;
    scrollbar:        true;
    cycle:            true;
    padding:          6px 0px 0px 0px;
    spacing:          3px;
    background-color: transparent;
    border:           0px;
}

element {
    padding:          9px 12px;
    border-radius:    8px;
    spacing:          10px;
    text-color:       @foreground0;
    background-color: transparent;
    cursor:           pointer;
}

element-icon {
    size:             22px;
    margin:           0 6px 0 0;
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
    highlight:        bold #e0e0e0;
}

element normal active {
    text-color:       @primary-hover;
}

element normal urgent {
    text-color:       @error;
}

/* Selection — subtle card, not a heavy inversion */
element selected {
    text-color:       @foreground1;
    background-color: @selected-bg;
    border:           1px solid;
    border-color:     @selected-border;
}

element selected active {
    text-color:       @foreground1;
    background-color: @selected-bg;
    border-color:     @primary-hover;
}

element selected urgent {
    text-color:       @foreground1;
    background-color: @selected-bg;
    border-color:     @error;
}

/* ── Scrollbar ─────────────────────────────────────────── */
scrollbar {
    width:            4px;
    padding:          0px 0px 0px 6px;
    handle-width:     4px;
    border:           0px;
    background-color: transparent;
    handle-color:     @shade2;
    border-radius:    2px;
}

/* ── Mode switcher (bottom tabs) ───────────────────────── */
mode-switcher {
    padding:          8px 0px 0px 0px;
    spacing:          6px;
    background-color: transparent;
    border:           0px;
}

button {
    padding:          6px 12px;
    border-radius:    8px;
    text-color:       @foreground-dim;
    background-color: @background1;
    border:           1px solid;
    border-color:     @shade1;
    cursor:           pointer;
}

button selected {
    text-color:       @foreground1;
    background-color: @background2;
    border-color:     @shade3;
}
