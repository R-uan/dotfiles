# Main background
theme[main_bg]="#151515"

# Main text color
theme[main_fg]="#c4c4c4"

# Title color for boxes
theme[title]="#6e6e6e"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8a8a8a"

# Background color of selected item in processes box
theme[selected_bg]="#242424"

# Foreground color of selected item in processes box
theme[selected_fg]="#a6a6a6"

# Color of inactive/disabled text
theme[inactive_fg]="#505050"

# Color of text appearing on top of graphs
theme[graph_text]="#c4c4c4"

# Background color of the percentage meters
theme[meter_bg]="#2a2a2a"

# Misc colors for processes box
theme[proc_misc]="#8a8a8a"

# Box outline colors
theme[cpu_box]="#6e6e6e"
theme[mem_box]="#8a8a8a"
theme[net_box]="#a6a6a6"
theme[proc_box]="#505050"

# Box divider line
theme[div_line]="#2a2a2a"

# Temperature graph
theme[temp_start]="#6e6e6e"
theme[temp_mid]="#505050"
theme[temp_end]="#8a8a8a"

# CPU graph
theme[cpu_start]="#6e6e6e"
theme[cpu_mid]="#8a8a8a"
theme[cpu_end]="#a6a6a6"

# Mem/Disk free meter
theme[free_start]="#6e6e6e"
theme[free_mid]="#8a8a8a"
theme[free_end]="#a6a6a6"

# Mem/Disk cached meter
theme[cached_start]="#505050"
theme[cached_mid]="#8a8a8a"
theme[cached_end]="#a4a4a4"

# Mem/Disk available meter
theme[available_start]="#a6a6a6"
theme[available_mid]="#8a8a8a"
theme[available_end]="#6e6e6e"

# Mem/Disk used meter
theme[used_start]="#303030"
theme[used_mid]="#505050"
theme[used_end]="#8a8a8a"

# Download graph
theme[download_start]="#6e6e6e"
theme[download_mid]="#8a8a8a"
theme[download_end]="#a4a4a4"

# Upload graph
theme[upload_start]="#a6a6a6"
theme[upload_mid]="#8a8a8a"
theme[upload_end]="#6e6e6e"

# Process box color gradient
theme[process_start]="#6e6e6e"
theme[process_mid]="#8a8a8a"
theme[process_end]="#a4a4a4"
