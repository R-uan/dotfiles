# mako notification daemon (1.11)
# Palette mirrors quickshell's dark theme (config/quickshell/config/Theme.dark.qml).
# Apply changes without restarting: makoctl reload

### Global

sort=-time
layer=overlay
anchor=top-right
max-visible=5
# quickshell's notification center reads `makoctl history -j`; the default of 5
# made the panel forget almost everything.
max-history=100
# Stack repeats from the same app instead of flooding the corner.
group-by=app-name,category

### Layout

font=Iosevka 12
width=350
height=110
margin=5
padding=7
border-size=1
border-radius=6
icons=0
# Only takes effect if icons=1.
max-icon-size=64

### Colors

background-color=#151515
text-color=#c4c4c4
border-color=#6e6e6e
# Default is blue; keep the "value" hint bar monochrome.
progress-color=over #303030

### Behavior

default-timeout=5000
ignore-timeout=1
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss

### Urgency

[urgency=low]
border-color=#505050
text-color=#8e8e8e
default-timeout=3000

[urgency=normal]
border-color=#6e6e6e
text-color=#c4c4c4

# NOTE: mako only knows low/normal/critical. The old [urgency=high] section
# never matched, so critical alerts were silently expiring after 5s.
[urgency=critical]
background-color=#1c1c1c
border-color=#a6a6a6
text-color=#e0e0e0
border-size=2
default-timeout=0

### Criteria

# Pick an action with rofi when a notification offers more than the default one.
[actionable]
on-button-middle=exec makoctl menu -n "$id" -- rofi -dmenu -p "Action"

# Placeholder shown once max-visible is exceeded.
[hidden]
format=<i>%h more notifications</i>
border-color=#505050
text-color=#8e8e8e

### Modes — toggle with: makoctl mode -t do-not-disturb

[mode=do-not-disturb]
invisible=1

# Critical alerts still get through while silenced.
[mode=do-not-disturb urgency=critical]
invisible=0
